/*
 * Per-process conda / docker assignment.
 *
 * Pointing at an EXISTING conda env: given a bare name like 'awgs_sv',
 * Nextflow treats it as a PACKAGE and tries to build a fresh env, which
 * fails. Given an absolute PREFIX PATH to an existing directory, it uses the
 * env directly. That prefix is params.conda_awgs_sv.
 *
 * ClairS-TO, Clair3 and VEP invoke `docker run` inline in their script bodies
 * rather than via Nextflow's `container` directive, which would nest docker in
 * docker. They still declare conda because the surrounding script uses
 * samtools/bcftools/tabix from the host env.
 *
 * ICHORCNA declares nothing: it calls absolute paths into its own env.
 */

process {
    withName: MERGE_MINKNOW        { conda = params.conda_awgs_sv }

    // ===== T2T track =====
    withName: REALIGN_T2T          { conda = params.conda_awgs_sv }
    withName: SNIFFLES             { conda = params.conda_awgs_sv }
    withName: CUTESV               { conda = params.conda_awgs_sv }
    withName: SEVERUS              { conda = params.conda_awgs_sv }
    withName: SURVIVOR_MERGE       { conda = params.conda_awgs_sv }
    withName: ANNOTATE_AL_FUSIONS  { conda = params.conda_awgs_sv }
    withName: AUGMENT_SV_SUPPORT   { conda = params.conda_awgs_sv }
    withName: MERGE_TRANSLOCATIONS { conda = params.conda_awgs_sv }
    withName: QC_ONTARGET          { conda = params.conda_awgs_sv }
    withName: FOCAL_INTRAGENIC_DUP { conda = params.conda_awgs_sv }   // needs pysam

    // ===== hg38 track =====
    withName: REALIGN_HG38         { conda = params.conda_awgs_sv }
    withName: CLAIRS_TO            { conda = params.conda_awgs_sv }
    withName: CLAIR3_PHASED        { conda = params.conda_awgs_sv }
    withName: VEP_ANNOTATE_CLAIR3  { conda = params.conda_awgs_sv }
    withName: FILTER_AL_REPORT     { conda = params.conda_awgs_sv }
    withName: FOCAL_TANDEM_DUP     { conda = params.conda_awgs_sv }   // needs pysam

    // ===== IGV, gene CNV, report =====
    withName: IGV_SNAPSHOTS          { conda = params.conda_awgs_sv }
    withName: GENE_CNV               { conda = params.conda_awgs_sv }
    withName: REPORT_BUNDLE          { conda = params.conda_awgs_sv }
    withName: DASHBOARD              { conda = params.conda_awgs_sv }
    withName: EMBED_REPORT_ASSETS    { conda = params.conda_awgs_sv }
    withName: REPORT_ZIP             { conda = params.conda_awgs_sv }
}
