/*
 * Per-process resource defaults, using nf-core-style labels. Modules attach
 * `label 'process_high'` and pick these up.
 *
 * The myeloma pipeline expressed the params.max_* ceilings through a
 * `def check_max(...)` helper defined in this file. Nextflow 24.10 and later
 * reject function definitions inside config files, so the clamping is inlined
 * into each closure instead. Behaviour is identical and this form parses on
 * both old and new Nextflow.
 */

process {

    cpus   = { Math.min(2, params.max_cpus as int) }
    memory = { def v = 8.GB; def c = params.max_memory as nextflow.util.MemoryUnit; v > c ? c : v }
    time   = { def v = 4.h;  def c = params.max_time   as nextflow.util.Duration;   v > c ? c : v }

    withLabel: process_low {
        cpus   = { Math.min(2, params.max_cpus as int) }
        memory = { def v = 4.GB; def c = params.max_memory as nextflow.util.MemoryUnit; v > c ? c : v }
        time   = { def v = 2.h;  def c = params.max_time   as nextflow.util.Duration;   v > c ? c : v }
    }
    withLabel: process_medium {
        cpus   = { Math.min(16, params.max_cpus as int) }
        memory = { def v = 32.GB; def c = params.max_memory as nextflow.util.MemoryUnit; v > c ? c : v }
        time   = { def v = 6.h;   def c = params.max_time   as nextflow.util.Duration;   v > c ? c : v }
    }
    withLabel: process_high {
        cpus   = { Math.min(32, params.max_cpus as int) }
        memory = { def v = 64.GB; def c = params.max_memory as nextflow.util.MemoryUnit; v > c ? c : v }
        time   = { def v = 12.h;  def c = params.max_time   as nextflow.util.Duration;   v > c ? c : v }
    }
    withLabel: process_xhigh {
        cpus   = { Math.min(64, params.max_cpus as int) }
        memory = { def v = 128.GB; def c = params.max_memory as nextflow.util.MemoryUnit; v > c ? c : v }
        time   = { def v = 24.h;   def c = params.max_time   as nextflow.util.Duration;   v > c ? c : v }
    }
    withLabel: process_long {
        time   = { def v = 48.h; def c = params.max_time as nextflow.util.Duration; v > c ? c : v }
    }
}
