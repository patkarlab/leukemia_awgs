/*
 * Per-process publishDir configuration.
 *
 * The tree is split by reference track, mirroring the MM pipeline's layout so
 * downstream tooling written against that structure keeps working. Override
 * --outdir to relocate the whole tree.
 */

process {

    // ===== T2T track =====
    withName: REALIGN_T2T {
        publishDir = [ path: { "${params.outdir}/t2t/bams" }, mode: 'copy',
                       pattern: '*.{t2t.bam,t2t.bam.bai}' ]
    }
    withName: SNIFFLES {
        publishDir = [ path: { "${params.outdir}/t2t/calls/sniffles" }, mode: 'copy',
                       pattern: '*.{vcf.gz,vcf.gz.tbi}' ]
    }
    withName: CUTESV {
        publishDir = [ path: { "${params.outdir}/t2t/calls/cutesv" }, mode: 'copy',
                       pattern: '*.{vcf.gz,vcf.gz.tbi}' ]
    }
    withName: SEVERUS {
        publishDir = [ path: { "${params.outdir}/t2t/calls/severus/${meta.id}" }, mode: 'copy' ]
    }
    withName: SURVIVOR_MERGE {
        publishDir = [ path: { "${params.outdir}/t2t/calls/merged" }, mode: 'copy',
                       pattern: '*.merged.vcf.gz*' ]
    }
    withName: ANNOTATE_AL_FUSIONS {
        publishDir = [ path: { "${params.outdir}/t2t/fusions" }, mode: 'copy', pattern: '*.tsv' ]
    }
    withName: AUGMENT_SV_SUPPORT {
        publishDir = [ path: { "${params.outdir}/t2t/fusions" }, mode: 'copy', pattern: '*.tsv' ]
    }
    withName: MERGE_TRANSLOCATIONS {
        publishDir = [ path: { "${params.outdir}/t2t/fusions" }, mode: 'copy', pattern: '*.tsv' ]
    }
    withName: QC_ONTARGET {
        publishDir = [ path: { "${params.outdir}/t2t/qc/${meta.id}" }, mode: 'copy' ]
    }
    withName: FOCAL_INTRAGENIC_DUP {
        publishDir = [ path: { "${params.outdir}/t2t/focal_dup" }, mode: 'copy', pattern: '*.tsv' ]
    }

    // ===== hg38 track =====
    withName: REALIGN_HG38 {
        publishDir = [ path: { "${params.outdir}/hg38/bams" }, mode: 'copy',
                       pattern: '*.{hg38.bam,hg38.bam.bai}' ]
    }
    withName: CLAIRS_TO {
        publishDir = [ path: { "${params.outdir}/hg38/calls/clairs_to/${meta.id}" }, mode: 'copy' ]
    }
    withName: ICHORCNA {
        publishDir = [ path: { "${params.outdir}/hg38/calls/ichorcna/${meta.id}" }, mode: 'copy' ]
    }
    withName: CLAIR3_PHASED {
        publishDir = [ path: { "${params.outdir}/hg38/clair3_phased/${meta.id}" }, mode: 'copy' ]
    }
    withName: VEP_ANNOTATE_CLAIR3 {
        publishDir = [ path: { "${params.outdir}/hg38/calls/annotated_clair3/${meta.id}" }, mode: 'copy' ]
    }
    withName: FILTER_AL_REPORT {
        publishDir = [ path: { "${params.outdir}/hg38/calls/al_filtered/${meta.id}" }, mode: 'copy' ]
    }
    withName: FOCAL_TANDEM_DUP {
        publishDir = [ path: { "${params.outdir}/hg38/focal_dup" }, mode: 'copy', pattern: '*.tsv' ]
    }
}
