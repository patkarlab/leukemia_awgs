/*
 * Per-process publishDir configuration.
 *
 * The tree is split by reference track, mirroring the MM pipeline's layout so
 * downstream tooling written against that structure keeps working. Override
 * --outdir to relocate the whole tree.
 */

process {

    // ===== T2T track =====
    withName: REALIGN_T2T {
        publishDir = [ path: { "${params.outdir}/t2t/bams" }, mode: 'copy',
                       pattern: '*.{t2t.bam,t2t.bam.bai}' ]
    }
    withName: SNIFFLES {
        publishDir = [ path: { "${params.outdir}/t2t/calls/sniffles" }, mode: 'copy',
                       pattern: '*.{vcf.gz,vcf.gz.tbi}' ]
    }
    withName: CUTESV {
        publishDir = [ path: { "${params.outdir}/t2t/calls/cutesv" }, mode: 'copy',
                       pattern: '*.{vcf.gz,vcf.gz.tbi}' ]
    }
    withName: SEVERUS {
        // Publish the canonical VCF only. Severus also writes per-cluster HTML
        // plots (80+ per sample) and intermediate CSVs that nothing reads. The
        // module now normalises the VCF to the task root so a plain pattern
        // matches it; while it lived inside severus_out/, which is itself a
        // declared path output, the directory was the publishable unit and the
        // file inside was never offered as a candidate.
        publishDir = [ path: { "${params.outdir}/t2t/calls/severus" },
                       mode: 'copy',
                       pattern: '*.severus.vcf' ]
    }
    withName: SURVIVOR_MERGE {
        publishDir = [ path: { "${params.outdir}/t2t/calls/merged" }, mode: 'copy',
                       pattern: '*.merged.vcf.gz*' ]
    }
    withName: ANNOTATE_AL_FUSIONS {
        publishDir = [ path: { "${params.outdir}/t2t/fusions" }, mode: 'copy', pattern: '*.tsv' ]
    }
    withName: AUGMENT_SV_SUPPORT {
        publishDir = [ path: { "${params.outdir}/t2t/fusions" }, mode: 'copy', pattern: '*.tsv' ]
    }
    withName: MERGE_TRANSLOCATIONS {
        publishDir = [ path: { "${params.outdir}/t2t/fusions" }, mode: 'copy', pattern: '*.tsv' ]
    }
    withName: QC_ONTARGET {
        publishDir = [ path: { "${params.outdir}/t2t/qc/${meta.id}" }, mode: 'copy' ]
    }
    withName: GENE_CNV {
        publishDir = [ path: { "${params.outdir}/t2t/gene_cnv" }, mode: 'copy' ]
    }
    withName: FOCAL_INTRAGENIC_DUP {
        publishDir = [ path: { "${params.outdir}/t2t/focal_dup" }, mode: 'copy', pattern: '*.tsv' ]
    }

    // ===== hg38 track =====
    withName: REALIGN_HG38 {
        publishDir = [ path: { "${params.outdir}/hg38/bams" }, mode: 'copy',
                       pattern: '*.{hg38.bam,hg38.bam.bai}' ]
    }
    withName: CLAIRS_TO {
        // The tmp_<sample> tree holds thousands of per-chunk pileup tensors,
        // split BEDs and intermediate VCFs. Only the final snv_ and indel_
        // VCFs are results; the rest stays in work/.
        publishDir = [ path: { "${params.outdir}/hg38/calls/clairs_to/${meta.id}" },
                       mode: 'copy',
                       pattern: 'clairs_to_out/{snv,indel}_*.vcf.gz*',
                       saveAs: { fn -> file(fn).name } ]
    }
    withName: ICHORCNA {
        publishDir = [ path: { "${params.outdir}/hg38/calls/ichorcna/${meta.id}" }, mode: 'copy' ]
    }
    withName: CLAIR3_PHASED {
        publishDir = [ path: { "${params.outdir}/hg38/clair3_phased/${meta.id}" }, mode: 'copy' ]
    }
    withName: VEP_ANNOTATE_CLAIR3 {
        // Publish only what is read downstream or read by a human. The full
        // all_annotated.tsv runs to ~900 MB per sample and annotated.vcf.gz to
        // ~180 MB, and nothing consumes either: FILTER_AL_REPORT takes the
        // candidates TSV alone. Both stay in work/ and are reachable there if
        // ever needed.
        publishDir = [ path: { "${params.outdir}/hg38/calls/annotated_clair3/${meta.id}" },
                       mode: 'copy',
                       saveAs: { fn ->
                           def base = fn.tokenize('/')[-1]
                           (base.endsWith('somatic_candidates.tsv') ||
                            base.endsWith('vep_summary.html') ||
                            base.endsWith('norm.vcf.gz') ||
                            base.endsWith('norm.vcf.gz.tbi')) ? base : null } ]
    }
    withName: FILTER_AL_REPORT {
        publishDir = [ path: { "${params.outdir}/hg38/calls/al_filtered/${meta.id}" }, mode: 'copy' ]
    }
    withName: FOCAL_TANDEM_DUP {
        publishDir = [ path: { "${params.outdir}/hg38/focal_dup" }, mode: 'copy', pattern: '*.tsv' ]
    }

    withName: 'REPORT_BUNDLE|DASHBOARD|EMBED_REPORT_ASSETS' {
        publishDir = [ enabled: false ]
    }
    withName: REPORT_ZIP {
        publishDir = [ path: { "${params.outdir}" }, mode: 'copy', pattern: '*.zip' ]
    }
}
