/*
 * Gandalf-specific configuration.
 *
 * /home/hemat is close to full, and Nextflow's default workDir is $PWD/work.
 * Override to /goast, which has headroom.
 */

workDir = '/goast/leukemia_awgs/work'

process { executor = 'local' }

executor {
    cpus   = 160
    memory = '1200.GB'
    name   = 'local'
}

params {
    max_cpus   = 48
    max_memory = '256.GB'
    max_time   = '72.h'
}

conda.enabled  = true
docker.enabled = true

// Keep any Nextflow-created conda envs off the full /home partition. Envs
// referenced by absolute prefix do not use this; it only matters if a future
// module specifies a package list.
conda.cacheDir = '/goast/leukemia_awgs/work/conda_cache'
