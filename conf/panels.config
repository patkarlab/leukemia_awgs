/*
 * Panel registry.
 *
 * One pipeline, two panels. Every panel-dependent path lives here and is
 * resolved per sample from meta.panel, so a mixed AML/ALL batch runs in a
 * single invocation. Sample sheets may carry an optional `panel` column; rows
 * that omit it fall back to --panel.
 *
 * Add a third panel by adding a block here and dropping its BEDs in assets/.
 * No workflow code changes.
 */

params {
    // Default panel for sample-sheet rows with no `panel` column.
    panel = 'AML'

    panels {
        AML {
            t2t_chr  = "${projectDir}/assets/AML_panel_t2t_chr.bed"
            t2t_nc   = "${projectDir}/assets/AML_panel_t2t_NC.bed"
            hg38     = "${projectDir}/assets/AML_panel_hg38.bed"
            targets  = "${projectDir}/assets/AML_panel_targets.tsv"
            // One feature per gene, unmerged and unflanked. Names a
            // breakpoint's gene; panel membership stays with t2t_chr.
            gene_model_t2t = "${projectDir}/assets/AML_gene_model_t2t.bed"
        }
        ALL {
            t2t_chr  = "${projectDir}/assets/ALL_panel_t2t_chr.bed"
            t2t_nc   = "${projectDir}/assets/ALL_panel_t2t_NC.bed"
            hg38     = "${projectDir}/assets/ALL_panel_hg38.bed"
            targets  = "${projectDir}/assets/ALL_panel_targets.tsv"
            // One feature per gene, unmerged and unflanked. Names a
            // breakpoint's gene; panel membership stays with t2t_chr.
            gene_model_t2t = "${projectDir}/assets/ALL_gene_model_t2t.bed"
        }
    }
}
